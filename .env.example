# StoryForge Environment Configuration

# Gemini API Keys (Get free keys at https://aistudio.google.com/apikey)
# Add at least one key for AI features (Companion, Muse, Suggestions)
GOOGLE_API_KEY_1=

# Key rotation pool (optional, allows more quota headroom):
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=

# OpenRouter (optional, for explicit/unrestricted models):
# OPENROUTER_API_KEY=
# STORYFORGE_EXPLICIT_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Supabase Sync (optional, for cross-device cloud sync):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Image Generation (optional, Pollinations is used as keyless fallback):
# STORYFORGE_IMAGE_BASE_URL=
# STORYFORGE_IMAGE_API_KEY=
# STORYFORGE_IMAGE_MODEL=
# STORYFORGE_IMAGE_GEMINI=gemini-2.5-flash-image
